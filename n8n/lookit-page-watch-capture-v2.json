{
  "name": "Lookit Page Watch \u2014 Capture v2",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "page-watch-capture",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2c3d4e5-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -820,
        300
      ],
      "webhookId": "lookit-page-watch-capture"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-provider",
              "name": "provider",
              "value": "mshots",
              "type": "string"
            },
            {
              "id": "cfg-token",
              "name": "shared_token",
              "value": "CHANGE-ME-LONG-RANDOM-STRING",
              "type": "string"
            },
            {
              "id": "cfg-hosts",
              "name": "allowed_hosts",
              "value": "CHANGE-ME-ALLOWED-HOSTS",
              "type": "string"
            },
            {
              "id": "cfg-burl",
              "name": "browserless_url",
              "value": "http://127.0.0.1:3000/screenshot?token=CHANGE-ME-BROWSERLESS-TOKEN",
              "type": "string"
            },
            {
              "id": "cfg-url",
              "name": "url",
              "value": "={{ $json.body.url }}",
              "type": "string"
            },
            {
              "id": "cfg-width",
              "name": "width",
              "value": "={{ $json.body.width }}",
              "type": "number"
            },
            {
              "id": "cfg-full",
              "name": "full_page",
              "value": "={{ $json.body.full_page === false ? false : true }}",
              "type": "boolean"
            },
            {
              "id": "cfg-sent",
              "name": "sent_token",
              "value": "={{ $json.headers['x-lookit-token'] || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -600,
        300
      ],
      "notes": "Replace shared_token and allowed_hosts before activation. allowed_hosts is a comma-separated list of exact hosts or *.example.com wildcards."
    },
    {
      "parameters": {
        "jsCode": "const cfg = $input.first().json;\nconst placeholder = 'CHANGE-ME-LONG-RANDOM-STRING';\nconst hostPlaceholder = 'change-me-allowed-hosts';\nconst patterns = String( cfg.allowed_hosts || '' ).split( ',' ).map( value => value.trim().toLowerCase().replace( /\\.$/, '' ) ).filter( Boolean );\nlet parsed = null;\ntry {\n  parsed = new URL( String( cfg.url || '' ) );\n} catch ( error ) {}\nconst host = parsed ? parsed.hostname.toLowerCase().replace( /\\.$/, '' ) : '';\nconst protocolAllowed = parsed && ( parsed.protocol === 'http:' || parsed.protocol === 'https:' ) && ! parsed.username && ! parsed.password;\nconst hostsConfigured = patterns.length > 0 && ! patterns.includes( hostPlaceholder );\nconst hostAllowed = protocolAllowed && hostsConfigured && patterns.some( pattern => pattern.startsWith( '*.' ) ? host.endsWith( pattern.slice( 1 ) ) && host !== pattern.slice( 2 ) : host === pattern );\nconst tokenAllowed = typeof cfg.shared_token === 'string' && cfg.shared_token.length >= 32 && cfg.shared_token !== placeholder && cfg.sent_token === cfg.shared_token;\nconst requestedWidth = Number( cfg.width );\nconst width = Number.isFinite( requestedWidth ) ? Math.max( 320, Math.min( 1920, Math.round( requestedWidth ) ) ) : 1440;\nconst url = parsed ? parsed.toString() : '';\nreturn [ { json: {\n  authorised: Boolean( tokenAllowed && hostAllowed ),\n  provider: cfg.provider === 'browserless' ? 'browserless' : 'mshots',\n  browserless_url: cfg.browserless_url,\n  url,\n  width,\n  full_page: Boolean( cfg.full_page ),\n  mshots_target: url ? url + ( url.includes( '?' ) ? '&' : '?' ) + 'pw=' + Date.now() : ''\n} } ];"
      },
      "id": "b2c3d4e5-0014-4000-8000-000000000014",
      "name": "Validate request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -490,
        300
      ],
      "notes": "Rejects placeholder credentials and hosts not explicitly allowed, then clamps capture width."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "auth-1",
              "leftValue": "={{ $json.authorised }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2c3d4e5-0003-4000-8000-000000000003",
      "name": "Authorised?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -380,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "sw-1",
                    "leftValue": "={{ $json.provider }}",
                    "rightValue": "browserless",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "browserless"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "mshots"
        }
      },
      "id": "b2c3d4e5-0004-4000-8000-000000000004",
      "name": "Which provider",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        -160,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.browserless_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.url, options: { type: 'png', fullPage: $json.full_page }, viewport: { width: $json.width, height: 1000, deviceScaleFactor: 1 }, gotoOptions: { waitUntil: 'networkidle2', timeout: 45000 }, waitForTimeout: 1500 }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          },
          "timeout": 60000
        }
      },
      "id": "b2c3d4e5-0005-4000-8000-000000000005",
      "name": "Browserless screenshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        120,
        140
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://s.wordpress.com/mshots/v1/{{ encodeURIComponent($json.mshots_target) }}?w={{ Math.min($json.width, 1280) }}&h=960",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          },
          "timeout": 30000
        }
      },
      "id": "b2c3d4e5-0006-4000-8000-000000000006",
      "name": "Ask mShots to render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        400
      ],
      "onError": "continueRegularOutput",
      "notes": "mShots caps images at 1280x960 and cannot render full pages. Use the browserless provider if you need the whole page."
    },
    {
      "parameters": {
        "jsCode": "// mShots renders asynchronously. The first request queues the job and hands\n// back a grey placeholder, so wait before asking for the real image.\nawait new Promise( ( resolve ) => setTimeout( resolve, 5000 ) );\nreturn $('Validate request').all();"
      },
      "id": "b2c3d4e5-0007-4000-8000-000000000007",
      "name": "Give it 5 seconds",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        400
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://s.wordpress.com/mshots/v1/{{ encodeURIComponent($json.mshots_target) }}?w={{ Math.min($json.width, 1280) }}&h=960",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          },
          "timeout": 45000
        }
      },
      "id": "b2c3d4e5-0008-4000-8000-000000000008",
      "name": "Collect mShots image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        400
      ],
      "onError": "continueErrorOutput",
      "notes": "mShots caps images at 1280x960 and cannot render full pages. Use the browserless provider if you need the whole page."
    },
    {
      "parameters": {
        "jsCode": "// Pull the image through the binary helper so this works whether n8n keeps\n// binaries in memory or on the filesystem.\nconst cfg = $('Validate request').first().json;\nconst item = $input.first();\nconst bin = item.binary && item.binary.data ? item.binary.data : null;\n\nlet buffer;\ntry {\n  buffer = await this.helpers.getBinaryDataBuffer( 0, 'data' );\n} catch ( e ) {\n  return [ { json: { ok: false, error: 'The capture provider returned no image.' } } ];\n}\n\nif ( ! buffer || ! buffer.length ) {\n  return [ { json: { ok: false, error: 'The capture provider returned an empty image.' } } ];\n}\n\nif ( buffer.length > 8388608 ) {\n  return [ { json: { ok: false, error: 'The capture provider returned an image larger than 8 MB.' } } ];\n}\n\n// mShots hands back a small grey placeholder while it renders.\nif ( cfg.provider !== 'browserless' && buffer.length < 8000 ) {\n  return [ { json: { ok: false, retry: true, error: 'mShots is still rendering this page.' } } ];\n}\n\nreturn [ {\n  json: {\n    ok: true,\n    provider: cfg.provider,\n    url: cfg.url,\n    width: cfg.width,\n    full_page: cfg.full_page,\n    mime: ( bin && bin.mimeType ) ? bin.mimeType : 'image/jpeg',\n    bytes: buffer.length,\n    captured_at: new Date().toISOString(),\n    image_base64: buffer.toString( 'base64' )\n  }\n} ];"
      },
      "id": "b2c3d4e5-0009-4000-8000-000000000009",
      "name": "Build payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        260
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "b2c3d4e5-0010-4000-8000-000000000010",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1000,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const err = $input.first().json || {};\nconst raw = String( err.message || err.error || '' );\nconst unreachable = /EAI_AGAIN|ECONNREFUSED/i.test( raw );\nconst retryable = /ETIMEDOUT|ECONNRESET|socket hang up|EAI_AGAIN|timeout/i.test( raw );\nconst message = unreachable\n  ? 'n8n cannot reach the configured browser container.'\n  : 'The capture provider could not render the page.';\nreturn [ { json: { ok: false, retry: retryable, error: message } } ];"
      },
      "id": "b2c3d4e5-0011-4000-8000-000000000011",
      "name": "Capture failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        560
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 502,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "b2c3d4e5-0012-4000-8000-000000000012",
      "name": "Respond capture error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1000,
        560
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'Unauthorised or invalid URL.' }) }}",
        "options": {
